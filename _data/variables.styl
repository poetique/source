// Title Font, set it to font family you want.
$font-family-headings = 'Klee One', 'Adobe Caslon Pro', 'Times New Roman', 'Ryumin Light KL', 'A-OTF Ryumin Pro L-KL', 'A-OTF-RyuminPro-Light', 'Ryumin Medium KL', "リュウミン L-KL", "Ryumin Regular KL", "ヒラギノ明朝 ProN", "Hiragino Mincho ProN", "游明朝体", "Yu Mincho", serif

// Set it to font family you want.
$font-family-base = 'Adobe Caslon Pro', 'Times New Roman', 'Ryumin Light KL', 'A-OTF Ryumin Pro L-KL', 'A-OTF-RyuminPro-Light', 'Ryumin Medium KL', "リュウミン L-KL", "Ryumin Regular KL", "ヒラギノ明朝 ProN", "Hiragino Mincho ProN", "游明朝体", "Yu Mincho", serif

// Code Font.
$code-font-family = "Input Mono", "PT Mono", Consolas, Monaco, Menlo, monospace

// Font size of articles.
$font-size-base = 17px

// Font size of table and code.
$table-font-size = 13px

// Line height for body text — generous for JP/FR mixed text
$line-height-base = 2.0

// Content width — max-width based for optimal readability
$content-desktop = 720px
$content-desktop-large = 800px
$content-desktop-largest = 860px

$content-bg-color = #d5ecf5;

$brand-color = #f0adb4;

$body-bg-color = #fcffff;

// Link colors — subtle distinction from body text
$link-color = #555
$link-hover-color = #222
