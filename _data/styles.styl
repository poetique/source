// ============================================================
// INDEX PAGE — Card Layout
// ============================================================

.content-index {
  display: block;
}

.post-block-index {
  width: 100%;
}

article.post-block-index {
  margin: 1rem!important;
  border-left: solid #000 0px!important;
  border-top: solid #000 0px!important;
  position: relative!important;
  background-size: cover!important;
  background-position: center center!important;
  background-color: rgba(#fff, 0.5)!important;
  background-blend-mode: overlay!important;
	transition: color .3s, background .3s, box-shadow .3s, transform .3s;
}

article.post-block-index::before {
  position:absolute;
  top:0;
  left:0;
  width:100%;
  height:100%;
  content: '';
  background-color: #13c5fd;
  opacity: .72;  /* 不透明度 */
}

a.index-a {
  text-decoration: none!important;
  border-bottom: 0px!important;
}


.post-index-author {
  padding: 10px 0;
  text-align: center;
}

.post-prop {
  margin: 1rem 0 0 1rem;
}
.catcolor {
  font-size: clamp(10px, 1vw, 20px);
  color: #fff!important;
  background-color: #1c55a6!important;
  border: solid #000 1px!important;
  border-radius: 8px;
  opacity: 0.7;
  padding: 5px 2px;
  margin-left: 1.5rem;
  letter-spacing: 2px;
  }

.catcolor1 {
  color: #fff!important;
  background-color: #b8a502!important;
  border: solid #b8a502 1px!important;
  border-radius: 8px;
  opacity: 0.5;
  padding: 5px 2px;
  margin-left: 1rem;
  letter-spacing: 2px;
}


.post-title-index {
  padding-top: 2rem;
  color: #000;
  text-shadow:1px 1px 0 #FFF, -1px -1px 0 #FFF,
              -1px 1px 0 #FFF, 1px -1px 0 #FFF,
              0px 1px 0 #FFF,  0-1px 0 #FFF,
              -1px 0 0 #FFF, 1px 0 0 #FFF;}

// ============================================================
// INDEX — Hover Action
// ============================================================

.item {
    max-width: 500px;
    margin: 0 auto;
    position: relative;
    &:hover .item__text {
      opacity: 1;
    }
    &__img {
        width: 100%;
        height: 100%;
    }
    &__text {
        position: absolute;
        width: 100%;
        height: 100%;
        top: 0;
        left: 0;
        text-align: center;
        color: #fff;
        background-color: rgba(0,0,0,0.3);
        transition: .6s ease-in-out;
        opacity: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        font-size: clamp(12px, 1vw, 40px);
        p {
            line-height: 1.8;
        }
    }
}
.item:hover .index-hide {
  opacity: 0!important;
  transition: .6s ease-in-out!important;
}


// ============================================================
// INDEX — Text Styles
// ============================================================

.quote {
    padding-left: 5px;
    margin: 0 0 0 auto;
    font-size: 0.5rem;
}

.index-title {
    text-align: center!important;
    font-family: 'Shippori Mincho B1', serif!important;
    letter-spacing: 0.3rem;
    padding-bottom: 1.5rem;
}
.index-author {
    text-align: center!important;
    font-family: 'Shippori Mincho B1', serif!important;
    font-size: clamp(12px, 1vw, 18px);
    letter-spacing: 0.5rem;
    padding-bottom: 1.5rem;
}
.index-summary {
    font-family: 'Shippori Mincho B1', serif!important;
    font-size: clamp(10px, 1vw, 12px);
    overflow: hidden;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    padding: 1rem;
    max-width: 600px;
    margin: 0 auto;
    text-align: left;
}

.post-gallery {
  width: 100%;
  max-width: 50%;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 auto 15px!important;
  padding: 0;
}

.index-gallery-image {
  max-width: 100%;
  height: auto;
  display: block;
  margin: 0 auto 15px;
}

.pagination {
  width: 100%;
  text-align: center;
  margin: 2rem 0;
}

.index-footer {
  position: absolute;
  bottom: 0;
  text-align: right;
}


// ============================================================
// LAYOUT — Content Width Management
// ============================================================

.main-inner {
  width: 90%;
  max-width: 860px;
  margin: 0 auto;
  padding: 0 1rem;
}

.page-inner, .archive-inner {
  width: 90% !important;
  max-width: 760px;
  margin: 0 auto;
}

.top-main-inner {
  width: 90%;
  max-width: 640px;
  margin: 0 auto;
}

// ============================================================
// POST — Article Body Typography
// ============================================================

.post-block {
  margin-top: 1.5rem!important;
}

.post-body {
    font-family: 'Shippori Mincho B1', serif!important;
    margin: 0 auto;
    padding: 0 0.5rem;
    text-align: justify;
    text-justify: inter-ideograph;
    max-width: 720px;
    line-height: 2.0;
    word-break: break-word;
    overflow-wrap: break-word;
}

// Paragraph spacing
.post-body p {
    margin-bottom: 1.4em;
    margin-top: 0;
}

// List styling
.post-body ul,
.post-body ol {
    margin-bottom: 1.4em;
    padding-left: 1.5em;
    text-align: left;
}

.post-body li {
    margin-bottom: 0.5em;
    line-height: 1.9;
}

// Headings in post body
.post-body h2 {
    margin-top: 2.5em;
    margin-bottom: 1em;
    padding-bottom: 0.4em;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    font-family: 'Klee One', 'Shippori Mincho B1', serif;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-align: left;
}

.post-body h3 {
    margin-top: 2em;
    margin-bottom: 0.8em;
    font-family: 'Klee One', 'Shippori Mincho B1', serif;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-align: left;
}

// Blockquote — elegant style for poetry quotations
.post-body blockquote {
    margin: 2em 0;
    padding: 1.2em 1.5em;
    border-left: 3px solid #c3a6a0;
    background-color: rgba(240, 173, 180, 0.06);
    font-style: italic;
    color: #444;
    line-height: 2.0;
    border-radius: 0 4px 4px 0;
}

.post-body blockquote p {
    margin-bottom: 0.8em;
}

.post-body blockquote p:last-child {
    margin-bottom: 0;
}

// Images in post body
.post-body img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 1.5em auto;
    border-radius: 2px;
}

// Horizontal rules
.post-body hr {
    border: none;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    margin: 2.5em 0;
}

// Links in post body
.post-body a {
    color: $link-color;
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 0, 0, 0.15);
    transition: color 0.2s, border-color 0.2s;
}

.post-body a:hover {
    color: $link-hover-color;
    border-bottom-color: rgba(0, 0, 0, 0.4);
}


// ============================================================
// POST — Title, Meta & Header
// ============================================================

.post-title {
    text-align: center!important;
    font-family: 'Shippori Mincho B1', serif!important;
    letter-spacing: 0.3rem;
    padding-bottom: 1.5rem;
    font-size: clamp(1.4rem, 3vw, 2rem);
    line-height: 1.5;
}

.post-meta {
    text-align: center!important;
    font-family: 'Klee One';
    font-size: 0.9rem;
    color: #888;
    line-height: 1.8;
}

.post-edit-link {
    font-size: 1rem!important;
}

.photo-from {
    font-size: 0.5rem!important;
}

// Post navigation (prev/next)
.post-nav {
    display: flex;
    justify-content: space-between;
    margin-top: 2.5em;
    padding-top: 1.5em;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
}

.post-nav-item {
    max-width: 48%;
}

.post-nav-item a {
    font-size: 0.9rem;
    color: #555;
    text-decoration: none;
    transition: color 0.2s;
}

.post-nav-item a:hover {
    color: $link-hover-color;
}


// ============================================================
// CITATION — Academic reference block
// ============================================================

.citation {
    margin-top: 2em;
    padding: 1em 1.2em;
    background-color: rgba(213, 236, 245, 0.3);
    border-left: 3px solid rgba(42, 100, 150, 0.3);
    border-radius: 0 4px 4px 0;
    font-size: 0.85rem;
    line-height: 1.7;
    color: #555;
    font-family: 'Klee One', serif;
}


// ============================================================
// SITE HEADER & NAVIGATION
// ============================================================

h1.site-title {
   color: #7d7d7d !important;
   font-weight: 100 !important;
   font-size: clamp(2.5rem, 5vw, 4.5rem) !important;
   margin-top: 0.7rem !important;
   letter-spacing: 0.05em;
   transition: font-size 0.3s ease;
}

.header {
    z-index: 0;
}

.header-inner {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.site-nav {
    font-size: 1.2rem;
    letter-spacing: 0.05em;
}

.site-brand-container {
    max-width: 100%;
}

.subtitle {
    font-family: 'Shippori Mincho B1', serif;
    letter-spacing: 1.2rem;
    font-size: 1rem;
}


// ============================================================
// TERMS / KEYWORDS
// ============================================================

.terms-body {
    padding-left: 10px;
}

.terms#author {
    text-align: right;
}


// ============================================================
// SIDEBAR
// ============================================================

div#no-result {
    display: none;
}

.sidebar {
    color: #bbb;
    font-size: 1.5rem;
    z-index: 100;
}

.site-description {
    font-size: 1.2rem !important;
}

.sidebar-toggle {
    bottom: 0px!important;
    right: 0px!important;
    width: 22px!important;
}

.back-to-top {
    font-size: 1.1rem;
}


// ============================================================
// COLUMNS
// ============================================================

.column-wrap {
    display: flex!important;
    margin-left: 2em!important;
}

.clmn {
    padding: 1em!important;
    width: 100%;
}


// ============================================================
// RESPONSIVE — Mobile (max-width: 767px)
// ============================================================

@media (max-width: 767px) {
  .main-inner {
    width: 100%;
    padding: 0 0.8rem;
  }

  .top-main-inner {
    width: 100%;
    margin: auto;
  }

  .page-inner, .archive-inner {
    width: 100% !important;
    padding: 0 0.5rem;
  }

  .content-index {
    display: block;
  }

  .post-block-index {
    width: 100%;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 8px;
  }

  .post-body {
    padding: 0 0.3rem;
    font-size: 0.95rem;
    line-height: 1.9;
  }

  .post-title {
    font-size: 1.3rem !important;
    letter-spacing: 0.15rem;
    padding-bottom: 1rem;
  }

  .post-nav {
    flex-direction: column;
    gap: 1em;
  }

  .post-nav-item {
    max-width: 100%;
  }

  .column-wrap {
    flex-direction: column !important;
    margin-left: 0 !important;
  }

  .subtitle {
    letter-spacing: 0.5rem;
    font-size: 0.8rem;
  }

  .site-nav {
    font-size: 1.1rem;
  }
}

// ============================================================
// RESPONSIVE — Small Mobile (max-width: 500px)
// ============================================================

@media (max-width: 500px) {
  .post-body {
    font-size: 0.9rem;
    line-height: 1.85;
  }

  .post-body blockquote {
    padding: 0.8em 1em;
    margin: 1.5em 0;
  }

  .citation {
    font-size: 0.78rem;
    padding: 0.8em;
  }
}


// ============================================================
// RESPONSIVE — Tablet (768px – 991px)
// ============================================================

@media (min-width: 768px) and (max-width: 991px) {
  .main-inner {
    width: 92%;
    max-width: 720px;
  }

  .post-body {
    padding: 0 0.5rem;
    font-size: 1rem;
  }

  .page-inner, .archive-inner {
    width: 88% !important;
    max-width: 680px;
  }
}


// ============================================================
// RESPONSIVE — Large Desktop (min-width: 1200px)
// ============================================================

@media (min-width: 1200px) {
  .main-inner {
    max-width: 880px;
  }

  .post-body {
    max-width: 740px;
    font-size: 1.05rem;
    line-height: 2.1;
  }

  .page-inner, .archive-inner {
    max-width: 800px;
  }
}


// ============================================================
// RESPONSIVE — Very Large Desktop (min-width: 1600px)
// ============================================================

@media (min-width: 1600px) {
  .main-inner {
    max-width: 920px;
  }

  .post-body {
    max-width: 760px;
    line-height: 2.15;
  }
}


// ============================================================
// RESPONSIVE — Grid (max-width: 768px)
// ============================================================

@media screen and (max-width: 768px) {
    .content {
        grid-auto-columns: auto;
    }
}
